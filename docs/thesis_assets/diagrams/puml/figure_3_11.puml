@startuml
title Activity Diagram - Đăng ký và xác thực email
skinparam shadowing false
skinparam linetype ortho
start
:Khách gửi username, email, password;
:POST /api/v1/users/register;
:UserServiceImpl chuẩn hóa email\nvà kiểm tra username/email duy nhất;
if (Dữ liệu hợp lệ?) then (Có)
  :Băm BCrypt password;
  :Gán role USER mặc định;
  :Sinh verification token thô;\nlưu token hash và thời hạn;
  :Lưu User chưa xác thực;
  :EmailServiceImpl gửi liên kết xác thực;
  :Trả thông báo yêu cầu xác thực email;
  :Khách mở liên kết trong email;
  :POST /api/v1/users/verify-email;
  if (Token hash khớp và còn hạn?) then (Có)
    :Đặt emailVerified = true;\nxóa token hash và expiry;
    :Tài khoản có thể đăng nhập;
  else (Không)
    :Trả EMAIL_VERIFICATION_INVALID;\nkhách có thể yêu cầu gửi lại email;
  endif
else (Không)
  :Trả lỗi validation hoặc trùng dữ liệu;
endif
stop
@enduml
