@startuml
title Activity Diagram - Yêu cầu và đặt lại mật khẩu
skinparam shadowing false
skinparam linetype ortho
start
:Khách nhập email;
:POST /api/v1/users/forgot-password;
:Tìm tài khoản đang hoạt động\nkhông bị xóa (nếu tồn tại);
:Sinh token reset thô;\nlưu hash và thời hạn;
:Gửi email liên kết reset;
:Luôn trả thông báo trung tính\nđể hạn chế lộ email tồn tại;
:Khách gửi token, mật khẩu mới, xác nhận mật khẩu;
:POST /api/v1/users/reset-password;
if (Token hash hợp lệ, còn hạn\nvà hai mật khẩu khớp?) then (Có)
  :Băm mật khẩu mới;
  :Tăng authVersion;\nxóa token reset/xác thực;
  :Thu hồi toàn bộ refresh session;
  :Trả kết quả thành công;
else (Không)
  :Trả PASSWORD_RESET_INVALID\nhoặc PASSWORD_CONFIRM_MISMATCH;
endif
stop
@enduml
