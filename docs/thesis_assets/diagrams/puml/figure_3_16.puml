@startuml
title Sequence Diagram - Scheduler hết hạn và đồng bộ trạng thái
autonumber
participant HoldExpireScheduler as HOLD
participant PendingBookingExpireScheduler as PENDING
participant ShowtimeStatusSyncScheduler as SHOWTIME
participant BookingServiceImpl as BOOKING
participant "Repositories" as REPO
database PostgreSQL as DB
participant SeatStatusPublisher as WS
HOLD -> REPO : find expired HOLD rows(limit)
REPO -> DB : indexed lookup by hold_until
HOLD -> REPO : release expired holds by ids
REPO -> DB : HOLD -> AVAILABLE
HOLD -> WS : afterCommit AVAILABLE events
PENDING -> REPO : find expired PENDING bookings(limit)
PENDING -> BOOKING : expirePendingBooking(id) per booking
BOOKING -> DB : PENDING -> EXPIRED; release applicable seats/payment
BOOKING -> WS : afterCommit AVAILABLE events
SHOWTIME -> REPO : update time-derived statuses
REPO -> DB : UPCOMING -> ONGOING -> ENDED where appropriate
@enduml
