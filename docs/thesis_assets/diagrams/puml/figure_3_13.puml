@startuml
title Sequence Diagram - Vòng đời đăng nhập, refresh và logout
autonumber
actor User
participant "React LoginPage\nauthApi / axiosClient" as FE
participant AuthenticationController as CTRL
participant AuthenticationService as AUTH
database PostgreSQL as DB
User -> FE : submit username/password
FE -> CTRL : POST /auth/token
CTRL -> AUTH : authenticate(request, httpRequest)
AUTH -> AUTH : rate limit + normalize + verify BCrypt
AUTH -> DB : load User/Roles/Permissions
AUTH -> DB : save hashed RefreshToken
AUTH --> CTRL : accessToken + refresh token/session response
CTRL --> FE : ApiResponse
FE -> FE : store access token, user, permissions
... Access token expires ...
FE -> CTRL : POST /auth/refresh
CTRL -> AUTH : refreshToken(...)
AUTH -> DB : lock refresh token hash
AUTH -> AUTH : validate token_use, expiry, auth_version
AUTH -> DB : revoke old token; save rotated token
AUTH --> CTRL : new token pair
CTRL --> FE : ApiResponse
User -> FE : chọn đăng xuất
FE -> CTRL : POST /auth/logout\n(withCredentials)
CTRL -> AUTH : logout(refresh token, request metadata)
AUTH -> DB : revoke refresh token; invalidate access token ID
CTRL --> FE : clear HttpOnly refresh cookie
FE -> FE : clear access token, user và permission state
@enduml
