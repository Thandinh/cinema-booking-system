# Database
DB_NAME=cinema_booking
DB_USER=cinema_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT_EXTERNAL=5433
DB_PORT_INTERNAL=5432
DB_SSLMODE=disable

# Server / app URL
SERVER_PORT=8080
TIMEZONE=Asia/Ho_Chi_Minh
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# SQL / Migration / JPA
SQL_INIT_MODE=never
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1
JPA_OPEN_IN_VIEW=false
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
HIBERNATE_DEFAULT_BATCH_FETCH_SIZE=50
HIBERNATE_GENERATE_STATISTICS=false
HIBERNATE_SLOW_QUERY_MS=0
HIBERNATE_SQL_LOG_LEVEL=WARN
HIBERNATE_BIND_LOG_LEVEL=WARN
CACHE_CAFFEINE_SPEC=maximumSize=1000,expireAfterWrite=10m

# Booking / seat hold
# Five minutes gives the customer enough time to review seats and complete a sandbox payment.
# Keep these values aligned unless the payment flow is intentionally configured otherwise.
BOOKING_SEAT_HOLD_MINUTES=5
BOOKING_PENDING_TIMEOUT_MINUTES=5
BOOKING_HOLD_RATE_LIMIT_ENABLED=true
BOOKING_HOLD_RATE_LIMIT_USER_MAX_REQUESTS=12
BOOKING_HOLD_RATE_LIMIT_IP_MAX_REQUESTS=60
BOOKING_HOLD_RATE_LIMIT_WINDOW_SECONDS=60
BOOKING_EXPIRED_HOLD_SCAN_DELAY_MS=10000
BOOKING_EXPIRED_HOLD_SCAN_LIMIT=500
BOOKING_EXPIRED_BOOKING_SCAN_DELAY_MS=10000
BOOKING_EXPIRED_BOOKING_SCAN_LIMIT=200

# Showtime
SHOWTIME_PUBLIC_DAYS_AHEAD=7
SHOWTIME_BOOKING_CUTOFF_MINUTES=15
SHOWTIME_STATUS_SYNC_DELAY_MS=60000

# Security
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_VALID_DURATION=900
JWT_REFRESH_TOKEN_VALID_DURATION=604800
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Bootstrap is disabled by default. Enable once only to create the first admin,
# then set APP_BOOTSTRAP_ADMIN_ENABLED=false and restart the application.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123
APP_DEMO_ACCOUNTS_ENABLED=false

# Email verification / password reset
EMAIL_VERIFICATION_EXPIRES_MINUTES=1440
PASSWORD_RESET_EXPIRES_MINUTES=30

# Email SMTP
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password

# VNPay sandbox
VNP_TMN_CODE=your-vnpay-tmn-code
VNP_HASH_SECRET=your-vnpay-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-callback

# MoMo sandbox/business. Keep disabled until valid credentials exist.
MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=captureWallet
MOMO_REDIRECT_URL=http://localhost:8080/api/v1/payments/momo-return
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo-ipn
MOMO_LANG=vi

# SePay / VietQR. Keep disabled until your receiving account and webhook are configured.
SEPAY_ENABLED=false
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_DESCRIPTION_PREFIX=CBK
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_HMAC_SECRET=

# Ticket QR / check-in
TICKET_QR_SECRET=
TICKET_CHECK_IN_EARLY_MINUTES=60
TICKET_CHECK_IN_LATE_MINUTES=30

# Keep file logging for local development. Prefer stdout or a managed log sink in production.
LOG_FILE=logs/application.log
