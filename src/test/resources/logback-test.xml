<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.cinema.booking" level="WARN"/>
    <logger name="com.cinema.booking.configuration.ApplicationInitConfig" level="ERROR"/>
    <logger name="com.cinema.booking.service.impl.PaymentServiceImpl" level="OFF"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.sql.results.jdbc.internal.DeferredResultSetAccess" level="ERROR"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.data.web.config.SpringDataJacksonConfiguration$PageModule$WarningLoggingModifier" level="ERROR"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
